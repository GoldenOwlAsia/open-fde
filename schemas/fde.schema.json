{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openfde.dev/schemas/fde.schema.json",
  "title": "OpenFDE Engagement",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "openfde.dev/v1alpha1" },
    "kind": { "const": "Engagement" },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "spec": {
      "type": "object",
      "required": ["customer", "objective"],
      "properties": {
        "customer": {
          "type": "object",
          "required": ["name"],
          "properties": { "name": { "type": "string", "minLength": 1 } },
          "additionalProperties": true
        },
        "objective": {
          "type": "object",
          "required": ["summary"],
          "properties": { "summary": { "type": "string", "minLength": 1 } },
          "additionalProperties": true
        },
        "successMetrics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "target"],
            "properties": {
              "name": { "type": "string" },
              "target": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "environment": {
          "type": "object",
          "properties": {
            "cloud": { "type": "string" },
            "regions": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        },
        "systems": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type"],
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string" },
              "access": { "enum": ["read_only", "read_write", "unknown"] }
            },
            "additionalProperties": true
          }
        },
        "constraints": {
          "type": "object",
          "properties": {
            "dataResidency": {
              "type": "object",
              "properties": {
                "allowedRegions": { "type": "array", "items": { "type": "string" } }
              },
              "additionalProperties": true
            },
            "pii": {
              "type": "object",
              "properties": {
                "allowExternalModel": { "type": "boolean" }
              },
              "additionalProperties": true
            },
            "humanApproval": {
              "type": "object",
              "properties": {
                "requiredFor": { "type": "array", "items": { "type": "string" } }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "reliability": {
          "type": "object",
          "properties": {
            "timeout": { "type": "string" },
            "retry": { "type": "string" },
            "fallback": { "type": "string" }
          },
          "additionalProperties": true
        },
        "agents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "tools"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "description": { "type": "string" },
              "tools": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "system"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "description": { "type": "string" },
                    "system": { "type": "string", "minLength": 1 },
                    "access": { "enum": ["read_only", "read_write", "unknown"] },
                    "sideEffects": { "type": "boolean" },
                    "containsPii": { "type": "boolean" }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "evaluation": {
          "type": "object",
          "properties": {
            "required": { "type": "boolean" },
            "suites": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "type", "location"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "type": { "enum": ["regression", "task-success"] },
                  "location": { "type": "string", "minLength": 1 },
                  "requiredBeforeDeploy": { "type": "boolean" },
                  "maxAgeDays": { "type": "integer" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": true
        },
        "checks": {
          "type": "object",
          "properties": {
            "overrides": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "severity", "reason"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "severity": { "enum": ["critical", "warning", "info"] },
                  "reason": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
