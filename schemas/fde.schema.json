{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openfde.dev/schemas/fde.schema.json",
  "title": "OpenFDE Engagement",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "openfde.dev/v1alpha1" },
    "kind": { "const": "Engagement" },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "spec": {
      "type": "object",
      "required": ["customer", "objective"],
      "properties": {
        "customer": {
          "type": "object",
          "required": ["name"],
          "properties": { "name": { "type": "string", "minLength": 1 } },
          "additionalProperties": true
        },
        "objective": {
          "type": "object",
          "required": ["summary"],
          "properties": { "summary": { "type": "string", "minLength": 1 } },
          "additionalProperties": true
        },
        "successMetrics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "target"],
            "properties": {
              "name": { "type": "string" },
              "target": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "environment": {
          "type": "object",
          "properties": {
            "cloud": { "type": "string" },
            "regions": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        },
        "systems": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type"],
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string" },
              "access": { "enum": ["read_only", "read_write", "unknown"] }
            },
            "additionalProperties": true
          }
        },
        "constraints": { "type": "object", "additionalProperties": true },
        "reliability": { "type": "object", "additionalProperties": true },
        "evaluation": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
